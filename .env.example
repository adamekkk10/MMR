# --- Database ---
POSTGRES_USER=rmm
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=rmm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RMM_SECRET_KEY=replace-me-with-a-long-random-string
RMM_JWT_ALGORITHM=HS256
RMM_ACCESS_TOKEN_TTL_MINUTES=60

# Public URL agents will connect to. In prod this should be https://rmm.example.com
RMM_PUBLIC_URL=http://localhost:8000

# How long without a heartbeat before an endpoint is marked offline (seconds)
RMM_OFFLINE_THRESHOLD_SECONDS=90

# First-run admin bootstrap. If set, on startup we create this user if no users exist.
RMM_BOOTSTRAP_ADMIN_USERNAME=admin
RMM_BOOTSTRAP_ADMIN_PASSWORD=admin

# CORS (comma-separated). In prod, restrict to your frontend origin.
RMM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
